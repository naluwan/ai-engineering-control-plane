# AI Engineering Control Plane — example environment
#
# Copy to .env.local and fill in real values:
#   cp .env.example .env.local
#
# .env.example is the only .env file tracked by git. It contains PLACEHOLDERS
# ONLY — never commit a real credential to any file in this repository.
#
# STATUS: DATABASE_URL and TEST_DATABASE_URL are read and validated by the
# application as of TASK-004. The remaining entries are the planned
# configuration surface, listed so the shape is agreed before the code that
# consumes them exists. Each is introduced by the task named beside it.

# --- Application ---------------------------------------------------------
# Public base URL of the running application.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (introduced in TASK-004) -----------------------------------
# Required. The application's PostgreSQL connection string, used by Prisma and
# by `prisma migrate`. Validated at server startup: it must be a well-formed
# URL using the postgresql:// or postgres:// protocol. Startup fails with a
# credential-free error when it is absent or malformed.
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME"

# Required to run the integration tests. DESTRUCTIVE TARGET: the suite deletes
# every Project, Requirement and Plan row from this database on each test.
# Never point it at a database holding data you care about.
#
# It must be a different database from DATABASE_URL. Test setup compares the
# two after trimming and refuses to run when they are equal.
TEST_DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME_test"

# Both values above are PLACEHOLDERS. Substitute your own local values in
# .env.local, which is git-ignored. The local Docker Compose credentials in
# docker-compose.yml are local-development-only and must not be copied here.

# --- Agent providers (introduced in TASK-007) ----------------------------
# Which LLM provider implementation to use.
# "mock" is the only value accepted in the MVP. See docs/DECISIONS.md ADR-003.
LLM_PROVIDER="mock"

# Artificial latency, in milliseconds, applied by the mock provider.
MOCK_PROVIDER_LATENCY_MS="0"

# --- Logging -------------------------------------------------------------
# One of: error | warn | info | debug
LOG_LEVEL="info"
